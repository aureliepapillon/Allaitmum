{
  "expo": {
    "name": "Allait'mum",
    "slug": "allaitmum-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EED9C4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.allaitmum.app",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Allait'mum utilise les notifications pour les rappels de vaccins et de tétées."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EED9C4"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.allaitmum.app",
      "permissions": ["NOTIFICATIONS"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#AB7058"
        }
      ]
    ]
  }
}
